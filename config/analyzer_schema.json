{
  "type": "object",
  "properties": {
    "metadata": {
      "type": "object",
      "properties": {
        "date": {"type": "string"},
        "source_category": {"type": "string"},
        "total_entries": {"type": "integer"}
      }
    },
    "articles": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "title": {"type": "string"},
          "original_link": {"type": "string"},
          "category": {"type": "string"},
          "summary_zh": {"type": "string"},
          "analysis": {
            "type": "object",
            "properties": {
              "location": {
                "type": "array",
                "items": {"type": "string"},
                "description": "事件相關實體地點，純數位事件留空陣列"
              },
              "actors": {
                "type": "array",
                "items": {"type": "string"},
                "minItems": 1,
                "maxItems": 3,
                "description": "人名或組織名，不填職稱描述"
              },
              "keywords": {
                "type": "array",
                "items": {"type": "string"},
                "minItems": 3,
                "maxItems": 3,
                "description": "3個研究關鍵詞，各對應一個分析維度，不重複，不使用過於寬泛的詞"
              },
              "actor_logic": {"type": "string"},
              "structural_change": {"type": "string"},
              "trend_implication": {"type": "string"}
            },
            "required": ["location", "actors", "keywords", "actor_logic", "structural_change", "trend_implication"]
          }
        },
        "required": ["title", "original_link", "category", "summary_zh", "analysis"]
      }
    }
  }
}
